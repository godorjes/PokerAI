{
  "name": "poker-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Poker AI V3.2 — 本地德州扑克与 AI 五人桌（Next.js + TypeScript，DeepSeek BYOK）",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run tests/rules",
    "test:contracts": "vitest run tests/contracts",
    "test:browser": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pokertools/engine": "2.1.0",
    "@pokertools/evaluator": "2.1.0",
    "@pokertools/types": "2.1.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "postcss": "^8.5.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
